{
  "openapi": "3.1.0",
  "info": {
    "title": "Riemann Inference Backend",
    "description": "Statistical dynamic recommendation engine for League of Legends ARAM: Mayhem and Arena",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/status": {
      "get": {
        "summary": "Catalog Status",
        "operationId": "catalog_status_v1_catalog_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog/sync": {
      "post": {
        "summary": "Catalog Sync",
        "operationId": "catalog_sync_v1_catalog_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SyncRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resolve/augment": {
      "post": {
        "summary": "Resolve Augment",
        "operationId": "resolve_augment_v1_resolve_augment_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveAugmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveAugmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommend/augments": {
      "post": {
        "summary": "Post Recommend Augments",
        "operationId": "post_recommend_augments_v1_recommend_augments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendAugmentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendAugmentsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommend/items": {
      "post": {
        "summary": "Post Recommend Items",
        "operationId": "post_recommend_items_v1_recommend_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendItemsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendItemsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/explain/build": {
      "post": {
        "summary": "Post Explain Build",
        "description": "Generate a localized explanation of up to five ranked item recommendations.",
        "operationId": "post_explain_build_v1_explain_build_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendItemsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildExplanationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NormalizedError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NormalizedError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NormalizedError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdapterRunReport": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "skipped"
            ],
            "title": "Status"
          },
          "last_sync_utc": {
            "type": "string",
            "title": "Last Sync Utc"
          },
          "rows_loaded": {
            "type": "integer",
            "title": "Rows Loaded",
            "default": 0
          },
          "rejected_rows": {
            "type": "integer",
            "title": "Rejected Rows",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "last_sync_utc"
        ],
        "title": "AdapterRunReport"
      },
      "ArenaSecondary": {
        "properties": {
          "top1_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top1 Rate"
          },
          "avg_placement": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Placement"
          }
        },
        "type": "object",
        "title": "ArenaSecondary"
      },
      "AugmentBindings": {
        "properties": {
          "weapon_of_destiny_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weapon Of Destiny Item Id"
          },
          "weapon_of_destiny_state": {
            "type": "string",
            "enum": [
              "auto",
              "open",
              "locked",
              "sold_or_unknown"
            ],
            "title": "Weapon Of Destiny State",
            "default": "auto"
          }
        },
        "type": "object",
        "title": "AugmentBindings"
      },
      "AugmentBreakdown": {
        "properties": {
          "pair_synergy_logit": {
            "type": "number",
            "title": "Pair Synergy Logit",
            "default": 0.0
          },
          "context_synergy_logit": {
            "type": "number",
            "title": "Context Synergy Logit",
            "default": 0.0
          },
          "overcap_penalty_delta_logit": {
            "type": "number",
            "title": "Overcap Penalty Delta Logit",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "AugmentBreakdown"
      },
      "AugmentMechanicsNote": {
        "properties": {
          "augment_id": {
            "type": "string",
            "title": "Augment Id"
          },
          "source_quote": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Quote"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "augment_id",
          "source_quote",
          "note"
        ],
        "title": "AugmentMechanicsNote"
      },
      "AugmentPhysicalMetrics": {
        "properties": {
          "usable_crit_added": {
            "type": "number",
            "title": "Usable Crit Added",
            "default": 0.0
          },
          "wasted_crit_added": {
            "type": "number",
            "title": "Wasted Crit Added",
            "default": 0.0
          },
          "converted_overflow_stats": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Converted Overflow Stats"
          }
        },
        "type": "object",
        "title": "AugmentPhysicalMetrics"
      },
      "AugmentRecommendation": {
        "properties": {
          "canonical_id": {
            "type": "string",
            "title": "Canonical Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "composite_score": {
            "type": "number",
            "title": "Composite Score"
          },
          "association_mean_logit": {
            "type": "number",
            "title": "Association Mean Logit"
          },
          "association_ci_90_logit": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Association Ci 90 Logit"
          },
          "standardized_wr_delta": {
            "type": "number",
            "title": "Standardized Wr Delta"
          },
          "mechanistic_delta_logit": {
            "type": "number",
            "title": "Mechanistic Delta Logit"
          },
          "bias_sensitivity_bound": {
            "type": "number",
            "title": "Bias Sensitivity Bound"
          },
          "sensitivity_envelope_logit": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Sensitivity Envelope Logit"
          },
          "mean_bias_margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Bias Margin"
          },
          "is_bias_robust_on_means": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Bias Robust On Means"
          },
          "envelope_gap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Envelope Gap"
          },
          "is_envelope_separated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Envelope Separated"
          },
          "effective_sample_size": {
            "type": "number",
            "title": "Effective Sample Size"
          },
          "corroboration": {
            "$ref": "#/components/schemas/CorroborationInfo"
          },
          "arena_secondary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArenaSecondary"
              },
              {
                "type": "null"
              }
            ]
          },
          "physical_metrics": {
            "$ref": "#/components/schemas/AugmentPhysicalMetrics"
          },
          "prior_mean_logit": {
            "type": "number",
            "title": "Prior Mean Logit"
          },
          "breakdown": {
            "$ref": "#/components/schemas/AugmentBreakdown"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            },
            "type": "array",
            "title": "Reasons"
          },
          "top_item_pivots": {
            "items": {
              "$ref": "#/components/schemas/ItemPivotSummary"
            },
            "type": "array",
            "title": "Top Item Pivots"
          }
        },
        "type": "object",
        "required": [
          "canonical_id",
          "display_name",
          "composite_score",
          "association_mean_logit",
          "association_ci_90_logit",
          "standardized_wr_delta",
          "mechanistic_delta_logit",
          "bias_sensitivity_bound",
          "sensitivity_envelope_logit",
          "effective_sample_size",
          "corroboration",
          "physical_metrics",
          "prior_mean_logit",
          "breakdown"
        ],
        "title": "AugmentRecommendation"
      },
      "BuildExplanationResponse": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "snapshot_id",
          "model",
          "explanation"
        ],
        "title": "BuildExplanationResponse"
      },
      "CatalogStatusResponse": {
        "properties": {
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "catalog_patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Patch"
          },
          "graph_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graph Version"
