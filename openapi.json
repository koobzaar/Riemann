            "propertyNames": {
              "enum": [
                "aram_mayhem",
                "arena"
              ]
            },
            "type": "object",
            "title": "Counts"
          },
          "locales": {
            "items": {
              "type": "string",
              "enum": [
                "en_us",
                "pt_br"
              ]
            },
            "type": "array",
            "title": "Locales",
            "default": [
              "en_us",
              "pt_br"
            ]
          },
          "adapters": {
            "items": {
              "$ref": "#/components/schemas/AdapterRunReport"
            },
            "type": "array",
            "title": "Adapters"
          },
          "mechanics_enrichment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MechanicsEnrichment"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "counts"
        ],
        "title": "CatalogStatusResponse"
      },
      "CorroborationInfo": {
        "properties": {
          "secondary_sources_checked": {
            "type": "integer",
